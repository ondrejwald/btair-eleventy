<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or site.title }} — {{ site.subtitle }}</title>
    <meta name="description" content="{{ site.description }}">

    <!-- Favicon (brand mark: yellow square with wave) -->
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/favicon.svg' | url }}">

    <link rel="stylesheet" href="{{ '/style.css' | url }}">

    <!-- Mobile hamburger menu + minor doplňky — inline so nothing has to be copied to style.css -->
    <style>
        /* Hamburger button — hidden on desktop */
        .nav-toggle {
            display: none;
            background: transparent;
            border: 0;
            padding: 10px;
            cursor: pointer;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
        }
        .nav-toggle__bar {
            display: block;
            width: 22px;
            height: 2px;
            background: #111;
            border-radius: 1px;
            transition: transform .25s ease, opacity .25s ease;
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(2) {
            opacity: 0;
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* === New stacked event cards: poster on top, text below, collapsible === */
        .events--stacked {
            list-style: none;
            padding: 0;
            margin: 20px 0 40px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 22px;
        }
        .event-card {
            display: flex;
            flex-direction: column;
            background: #DBE1F0;        /* light blue — matches brand */
            border-radius: 4px;
            overflow: hidden;
            transition: transform .25s ease, box-shadow .25s ease;
        }
        .event-card--past {
            background: #F2F2F0;        /* grey for past events */
            opacity: 0.85;
        }
        .event-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px -8px rgba(0, 0, 0, .15);
        }
        .event-card__poster {
            margin: 0;
            display: block;
            width: 100%;
            background: #FFFFFF;
            line-height: 0;
            min-height: 120px;        /* ensures a visible frame even before image loads */
            aspect-ratio: 16 / 9;      /* reserves vertical space */
            overflow: hidden;
        }
        .event-card__poster img {
            display: block;
            width: 100%;
            height: 100%;
            min-height: 120px;
            object-fit: cover;
            object-position: center;
        }.event-card__poster--logo {
    aspect-ratio: auto;
    min-height: 140px;
    padding: 20px 24px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}
.event-card__poster--logo img {
    max-width: 70%;
    max-height: 90px;
    width: auto;
    height: auto;
    min-height: 0;
    object-fit: contain;
    mix-blend-mode: multiply;
}
        .event-card__body {
            padding: 20px 22px 22px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .event-card__date {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.03em;
            color: #000;
            opacity: 0.75;
        }
        .event-card__title {
            margin: 4px 0 2px;
            font-size: 18px;
            line-height: 1.25;
            font-weight: 700;
            color: #000;
        }
        .event-card__org {
            margin: 0 0 10px;
            font-size: 13px;
            font-style: italic;
            color: #000;
            opacity: 0.7;
        }
        .event-card__details {
            margin-top: 6px;
        }
        .event-card__details > summary {
            cursor: pointer;
            display: inline-block;
            padding: 6px 0;
            font-size: 13px;
            font-weight: 700;
            color: #4E67AC;
            border-bottom: 2px solid #4E67AC;
            list-style: none;                                    /* hide default marker */
            transition: color .2s ease, border-color .2s ease;
        }
        .event-card__details > summary::-webkit-details-marker {
            display: none;                                        /* hide marker on Safari */
        }
        .event-card__details > summary::after {
            content: " ▾";
            display: inline-block;
            margin-left: 4px;
            transition: transform .2s ease;
        }
        .event-card__details[open] > summary::after {
            content: " ▴";
        }
        .event-card__details > summary:hover {
            color: #E7AF4A;
            border-color: #E7AF4A;
        }
        .event-card__desc {
            margin-top: 14px;
            font-size: 14.5px;
            line-height: 1.55;
            color: #000;
        }
        .event-card__desc p {
            margin: 0 0 10px;
        }
        .event-card__desc p:last-child {
            margin-bottom: 0;
        }
        .event-card__cta {
            display: inline-block;
            margin-top: 14px;
            padding: 6px 0;
            font-size: 13px;
            font-weight: 700;
            color: #4E67AC;
            border-bottom: 2px solid #4E67AC;
            text-decoration: none;
            transition: color .2s ease, border-color .2s ease;
        }
        .event-card__cta:hover {
            color: #E7AF4A;
            border-color: #E7AF4A;
        }

        @media (max-width: 720px) {
            .events--stacked {
                grid-template-columns: 1fr;
            }
        }

        /* === ARTINRES flags — smaller, rounded, less prominent === */
        .airlink__flag {
            width: 22px !important;
            height: 22px !important;
            border-radius: 50% !important;  /* kulaté */
            object-fit: cover;
            opacity: 0.55;                   /* méně výrazné */
            box-shadow: none !important;
            background: transparent !important;
            padding: 0 !important;
            transition: opacity .25s ease;
        }
        .airlink:hover .airlink__flag {
            opacity: 1;                      /* na hover plná sytost */
        }

        /* === Event / Pilot media — logo on transparent background === */
        /* Use high-specificity selectors + !important to override anything from style.css */
        .event .event__media.event__media--logo,
        figure.event__media--logo {
            background: transparent !important;
            background-color: transparent !important;
            background-image: none !important;
            border: 0 !important;
            border-color: transparent !important;
            box-shadow: none !important;
            outline: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 16px 20px !important;
            min-height: 120px !important;
            width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }
        .event__media--logo img {
            display: block;
            max-width: 80%;
            max-height: 70px;
            width: auto;
            height: auto;
            object-fit: contain;
            margin: 0 auto;
            mix-blend-mode: multiply;
            background: transparent;
        }

        /* === Partner logo box in Contacts === */
        .partner__logo-box {
            margin: 0 0 16px;
            padding: 14px;
            background: #FFFFFF;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 90px;
        }
        .partner__logo {
            max-width: 100%;
            max-height: 70px;
            width: auto;
            height: auto;
            object-fit: contain;
        }

        /* === Residency model cards (4 pilot-tested models) === */
        .models {
            list-style: none;
            padding: 0;
            margin: 20px 0 40px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }
        .model {
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 24px 24px 22px;
            background: #F6F5F0;
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: 3px;
            transition: background .25s ease, transform .25s ease, box-shadow .25s ease;
            min-height: 220px;
        }
        .model:hover {
            background: #FFF2BD;
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -8px rgba(0, 0, 0, .12);
        }
        .model__badge {
            display: inline-block;
            align-self: flex-start;
            margin-bottom: 14px;
            padding: 3px 10px;
            font-family: inherit;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #000;
            background: #FFD433;
            border-radius: 2px;
        }
        .model__title {
            font-weight: 700;
            font-size: 20px;
            line-height: 1.2;
            margin: 0 0 10px;
            color: #000;
        }
        .model__desc {
            font-size: 14.5px;
            line-height: 1.55;
            color: #333;
        }
        .model__desc p { margin: 0; }

        /* Smaller lead text under models */
        .section__lede--small {
            font-size: 15px;
            margin-top: 10px;
            margin-bottom: 18px;
            color: #555;
        }

        /* On mobile: show hamburger, hide nav by default, show it when .is-open */
        @media (max-width: 720px) {
            .nav-toggle {
                display: flex;
            }
            .models {
                grid-template-columns: 1fr;
            }
            .model {
                min-height: auto;
            }
            .topbar__inner .nav {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                flex-direction: column;
                background: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(8px);
                padding: 16px 20px 24px;
                box-shadow: 0 12px 24px -8px rgba(0, 0, 0, .15);
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
                gap: 2px;
                z-index: 50;
            }
            .topbar__inner .nav.is-open {
                display: flex;
            }
            .topbar__inner .nav a {
                padding: 12px 4px;
                font-size: 16px;
                border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            }
            .topbar__inner .nav a:last-child {
                border-bottom: 0;
            }
            .topbar__inner .nav a.is-active::after {
                left: 4px;
                right: auto;
                width: 24px;
            }
            /* The topbar needs to be relative so the dropdown positions correctly */
            .topbar__inner {
                position: relative;
