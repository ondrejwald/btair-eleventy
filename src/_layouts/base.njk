<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or site.title }} — {{ site.subtitle }}</title>
    <meta name="description" content="{{ site.description }}">

    <!-- Favicon (brand mark: yellow square with wave) -->
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/favicon.svg' | url }}">

    <link rel="stylesheet" href="{{ '/style.css' | url }}">

    <!-- Mobile hamburger menu + minor doplňky — inline so nothing has to be copied to style.css -->
    <style>
        /* Hamburger button — hidden on desktop */
        .nav-toggle {
            display: none;
            background: transparent;
            border: 0;
            padding: 10px;
            cursor: pointer;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
        }
        .nav-toggle__bar {
            display: block;
            width: 22px;
            height: 2px;
            background: #111;
            border-radius: 1px;
            transition: transform .25s ease, opacity .25s ease;
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(2) {
            opacity: 0;
        }
        .nav-toggle.is-open .nav-toggle__bar:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* === About grid: text left, lead partner logo right === */
        .about-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 220px;
            gap: 40px;
            align-items: start;
            margin-bottom: 48px;
        }
        .about-grid__text {
            margin: 0;
        }
        .about-grid__lead-partner {
            margin: 0;
            padding: 24px 20px;
            background: #FFF2BD;        /* light yellow — subtle brand accent */
            border-radius: 3px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .about-grid__lead-partner img {
            max-width: 100%;
            max-height: 80px;
            width: auto;
            height: auto;
            mix-blend-mode: multiply;
        }
        .about-grid__lead-partner figcaption {
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #000;
            opacity: 0.6;
        }
        @media (max-width: 720px) {
            .about-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            .about-grid__lead-partner {
                padding: 18px;
            }
            .about-grid__lead-partner img {
                max-height: 60px;
            }
        }

        /* === ARTINRES flags — smaller, rounded, less prominent === */
        .airlink__flag {
            width: 22px !important;
            height: 22px !important;
            border-radius: 50% !important;  /* kulaté */
            object-fit: cover;
            opacity: 0.55;                   /* méně výrazné */
            box-shadow: none !important;
            background: transparent !important;
            padding: 0 !important;
            transition: opacity .25s ease;
        }
        .airlink:hover .airlink__flag {
            opacity: 1;                      /* na hover plná sytost */
        }

        /* === Event poster image (full visible poster) === */
        .event__media--poster {
            background: #FFFFFF !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            overflow: hidden !important;
            padding: 0 !important;
            min-height: 180px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .event__media--poster img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 240px;
            object-fit: cover;
            object-position: center;
        }

        /* === Event / Pilot media — logo on transparent background === */
        /* Use high-specificity selectors + !important to override anything from style.css */
        .event .event__media.event__media--logo,
        figure.event__media--logo {
            background: transparent !important;
            background-color: transparent !important;
            background-image: none !important;
            border: 0 !important;
            border-color: transparent !important;
            box-shadow: none !important;
            outline: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 16px 20px !important;
            min-height: 120px !important;
            width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }
        .event__media--logo img {
            display: block;
            max-width: 80%;
            max-height: 70px;
            width: auto;
            height: auto;
            object-fit: contain;
            margin: 0 auto;
            mix-blend-mode: multiply;
            background: transparent;
        }

        /* === Partner logo box in Contacts === */
        .partner__logo-box {
            margin: 0 0 16px;
            padding: 14px;
            background: #FFFFFF;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 90px;
        }
        .partner__logo {
            max-width: 100%;
            max-height: 70px;
            width: auto;
            height: auto;
            object-fit: contain;
        }

        /* === Residency model cards (4 pilot-tested models) === */
        .models {
            list-style: none;
            padding: 0;
            margin: 20px 0 40px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }
        .model {
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 24px 24px 22px;
            background: #F6F5F0;
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: 3px;
            transition: background .25s ease, transform .25s ease, box-shadow .25s ease;
            min-height: 220px;
        }
        .model:hover {
            background: #FFF2BD;
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -8px rgba(0, 0, 0, .12);
        }
        .model__badge {
            display: inline-block;
            align-self: flex-start;
            margin-bottom: 14px;
            padding: 3px 10px;
            font-family: inherit;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #000;
            background: #FFD433;
            border-radius: 2px;
        }
        .model__title {
            font-weight: 700;
            font-size: 20px;
            line-height: 1.2;
            margin: 0 0 10px;
            color: #000;
        }
        .model__desc {
            font-size: 14.5px;
            line-height: 1.55;
            color: #333;
        }
        .model__desc p { margin: 0; }

        /* Smaller lead text under models */
        .section__lede--small {
            font-size: 15px;
            margin-top: 10px;
            margin-bottom: 18px;
            color: #555;
        }

        /* On mobile: show hamburger, hide nav by default, show it when .is-open */
        @media (max-width: 720px) {
            .nav-toggle {
                display: flex;
            }
            .models {
                grid-template-columns: 1fr;
            }
            .model {
                min-height: auto;
            }
            .topbar__inner .nav {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                flex-direction: column;
                background: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(8px);
                padding: 16px 20px 24px;
                box-shadow: 0 12px 24px -8px rgba(0, 0, 0, .15);
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
                gap: 2px;
                z-index: 50;
            }
            .topbar__inner .nav.is-open {
                display: flex;
            }
            .topbar__inner .nav a {
                padding: 12px 4px;
                font-size: 16px;
                border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            }
            .topbar__inner .nav a:last-child {
                border-bottom: 0;
            }
            .topbar__inner .nav a.is-active::after {
                left: 4px;
                right: auto;
                width: 24px;
            }
            /* The topbar needs to be relative so the dropdown positions correctly */
            .topbar__inner {
                position: relative;
            }
        }
    </style>
</head>
<body>
    {{ content | safe }}
    {% include "netlify-identity.njk" %}
</body>
</html>
